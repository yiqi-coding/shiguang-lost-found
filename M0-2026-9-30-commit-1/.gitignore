# ---------- 环境变量与密钥（红线：绝不提交） ----------
.env
.env.*
!.env.example
*.pem
*.key
!frontend/public/*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ---------- 类型检查与 lint 缓存 ----------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ---------- Node / 前端 ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/stats.html
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.local

# ---------- 构建与运行时产物 ----------
storage/
backend/storage/
*.log
logs/
celerybeat-schedule
*.pid
*.seed

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 大文件与演示素材（体积大，单独交接） ----------
data/images/*
!data/images/.gitkeep
*.mp4
*.mov
*.zip
*.7z

# ---------- 临时目录 ----------
tmp/
temp/
.tmp/
