# ---------- 大文件与演示素材（体积大，单独交接） ----------
data/images/*
!data/images/.gitkeep
!data/images/README.md
*.mp4
*.mov
*.zip
*.7z
*.tar.gz

# ---------- 交付清单产物（由 scripts/make_manifest.py 生成） ----------
# 说明：这两份文件随压缩包交付，但不进版本库 —— 每次内容变更都会让校验和全量失效，
#       留着只会制造无意义的 diff。需要时运行 `python scripts/make_manifest.py` 重新生成。
/MANIFEST.md
/CHECKSUMS.sha256

# ---------- 本地依赖解包目录（由 scripts/vendor_deps.py 生成） ----------
# **绝不提交**：体积约 7MB / 500 个文件，且第三方库各有许可证，
# 应由使用者在本地按需生成。重新生成：
#     python scripts/vendor_deps.py
#     $env:PYTHONPATH = "E:\ICT\.vendor"
.vendor/
.pipcache/

# ---------- 本地 wheel 缓存（由 scripts/fetch_wheels.py 生成） ----------
# **绝不提交**：这是本机离线装机的临时产物（上百 MB），
# 使用者应按 docs/deployment.md 用 requirements.txt 自行安装。
# 重新生成：python scripts/fetch_wheels.py -r backend/requirements.txt
.wheels/

# ---------- 临时目录 ----------
tmp/
temp/
.tmp/
