# =============================================================================
# 「拾光」环境变量示例
# -----------------------------------------------------------------------------
# 使用方式：
#   1) 复制为 .env（.env 已被 .gitignore 忽略，**严禁提交**）
#   2) 把 replace_me 换成真实值
#   3) 生产环境启动时会校验必填项，仍为 replace_me 会拒绝启动
#
# ⚠ 真实密钥只能通过部署平台的密钥管理注入，不得写入文档、源码、镜像或提交记录。
# =============================================================================

# ---------- 应用 ----------
APP_ENV=development                # development | demo | production
APP_NAME=shiguang
APP_VERSION=1.0.0
APP_SECRET_KEY=replace_me_with_32_bytes_random_string
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:5173

# ---------- 数据库（本地 MySQL 或华为云 RDS） ----------
DATABASE_URL=mysql+pymysql://shiguang_app:replace_me@localhost:3306/shiguang?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
DB_POOL_RECYCLE=3600

# ---------- Redis（本地或华为云 DAS Redis） ----------
REDIS_URL=redis://:replace_me@localhost:6379/0
REDIS_ENABLED=true                 # false 时系统自动降级为直连数据库
REDIS_TTL_AI_ATTRIBUTES=86400      # 24h
REDIS_TTL_MATCH=600                # 10min
REDIS_TTL_CLAIM_SESSION=1800       # 30min

# ---------- 对象存储（local 本地目录 | obs 华为云对象存储） ----------
# OBS_ENDPOINT 的格式：https://obs.<区域>.myhuaweicloud.com
#   ⚠ 区域必须与桶所在区域一致，否则会报 404 或跨区域访问失败。
#   常见区域示例（把 <区域> 换成实际值，不要照抄本行）：
#     cn-north-4（北京四）、cn-east-3（上海一）、cn-south-1（广州）
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
OBS_ENDPOINT=https://obs.replace_me.myhuaweicloud.com
OBS_REGION=replace_me
OBS_BUCKET=replace_me
OBS_ACCESS_KEY=replace_me
OBS_SECRET_KEY=replace_me
OBS_SIGNED_URL_EXPIRE=900          # 签名 URL 有效期（秒），默认 15 分钟
OBS_KEY_PREFIX=items

# ---------- MaaS / 模型服务 ----------
MAAS_ENDPOINT=https://replace_me
MAAS_API_KEY=replace_me
MAAS_MODEL=replace_me
MAAS_TIMEOUT=30
MAAS_ENABLED=false                 # false 时走规则提取（降级模式）

# ---------- 算法服务 ----------
ALGORITHM_SERVICE_URL=http://localhost:9000
ALGORITHM_TIMEOUT=30
ALGORITHM_FALLBACK_ENABLED=true    # 算法服务不可用时降级为本地规则匹配

# ---------- 匹配与业务参数 ----------
MATCH_TOP_K=5
MATCH_MIN_DISPLAY_SCORE=0.35
MATCH_CACHE_ENABLED=true
CLAIM_MAX_ATTEMPTS=3
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_COUNT=3
PAGE_SIZE_MAX=50

# ---------- 匹配权重（兜底默认值；权威来源为 algorithm/config/matching.yaml） ----------
MATCH_WEIGHT_CATEGORY=0.20
MATCH_WEIGHT_ATTRIBUTE=0.25
MATCH_WEIGHT_IMAGE=0.20
MATCH_WEIGHT_TIME=0.15
MATCH_WEIGHT_LOCATION=0.15
MATCH_WEIGHT_BRAND_MODEL=0.05

# ---------- Docker Compose 专用（仅容器编排使用，后端不读取） ----------
MYSQL_ROOT_PASSWORD=replace_me
MYSQL_USER=shiguang_app
MYSQL_PASSWORD=replace_me
REDIS_PASSWORD=replace_me

# ---------- 前端（构建期注入，放在 frontend/.env.*） ----------
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=拾光
